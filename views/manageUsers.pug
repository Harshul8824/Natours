extends base

block content
  main.main
    .card-container
      h2.heading-secondary.ma-bt-md #{title}
      if users && users.length > 0
        table.table(style="width:100%; text-align:left; font-size:1.5rem; background:#fff; padding:2rem; border-radius:3px;")
          thead
            tr
              th Name
              th Email
              th Role
              th Actions
          tbody
            each user in users
              tr(style="border-bottom: 1px solid #eee;")
                td= user.name
                td= user.email
                td= user.role
                td
                  button.btn.btn--small.btn--green(style="margin-right: 1rem") Edit
                  button.btn.btn--small.btn--red Delete
      else
        p No users found.
