extends base

block content
  main.main
    .card-container
      h2.heading-secondary.ma-bt-md #{title}
      if reviews && reviews.length > 0
        .reviews
          each review in reviews
            .reviews__card(style="width: 100%; margin-bottom: 2rem; background: #fff; padding: 2rem; border-radius: 3px;")
              h3.heading-tertiary= review.tour ? review.tour.name : 'Unknown Tour'
              p.reviews__text= review.review
              .reviews__rating
                each star in [1, 2, 3, 4, 5]
                  svg.reviews__star(class=`reviews__star--${review.rating >= star ? 'active' : 'inactive'}`)
                    use(xlink:href='/img/icons.svg#icon-star')
      else
        p You have not written any reviews yet.
